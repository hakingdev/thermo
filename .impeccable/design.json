      "html": "<article class=\"ds-card\"><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-site\" value=\"columbia\" aria-label=\"Выбрать Columbia\" checked /><span class=\"ds-choice-copy\">Columbia<span>Термобельё Omni-Heat</span></span><span class=\"ds-indicator\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span></label><div class=\"ds-card-bottom\"><span>Мужская и женская коллекции</span><a href=\"/?preview=columbia\" target=\"_blank\" rel=\"noreferrer\">Предпросмотр<svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></div></article>",
