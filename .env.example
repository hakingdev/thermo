# Фронт
VITE_FB_PIXEL_ID=4988165351454889
# Необязательно: отдельный пиксель Columbia. Без него используется VITE_FB_PIXEL_ID.
# VITE_COLUMBIA_FB_PIXEL_ID=4988165351454889

# Vercel → Settings → Environment Variables (НЕ в .env фронта!)
# DARKLEADS_API_KEY=ваш_ключ

# Серверный вход в админку (локально в .env.local, на Vercel в Environment Variables)
# SITE_ADMIN_USERNAME=admin
# SITE_ADMIN_PASSWORD=задайте_пароль

# Отдельная страница /columbia-track, серверные настройки Vercel.
# TRACK_DARKLEADS_API_KEY=ваш_ключ
# TRACK_DARKLEADS_PRODUCT_ID=121121
# TRACK_DARKLEADS_STREAM_ID=98074
# TRACK_DARKLEADS_PRICE=2490
# TRACK_DARKLEADS_CPA_ID=121121
# VITE_TRACK_FB_PIXEL_ID=необязательный_отдельный_Meta_ID
