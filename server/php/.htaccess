# Закрыть конфиг с ключом и лог заявок от просмотра
<FilesMatch "^(config\.php|config\.example\.php|admin-session\.php|site-admin\.config(?:\.example)?\.php|site-state\.json(?:\.lock|\.login-attempts)?|orders\.log)$">
  Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^api/site/?$ site.php [L]
RewriteRule ^api/admin/?$ admin.php [L]
RewriteRule ^api/columbia-lead/?$ columbia-api/api.php [L]

# Фронт шлёт заявки на /api/lead — отдаём их PHP-прокси
RewriteRule ^api/lead/?$ api.php [L]

# SPA: существующие файлы отдаём как есть, остальные пути (/ru, /thanks, /privacy) — в index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
